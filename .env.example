# DocSupport Enterprise RAG Platform Environment Configuration

# Server Ports & Mode
PORT=8000
NODE_ENV=development
ENVIRONMENT=development

# Database (PostgreSQL 16 + pgvector)
# For Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/docsupport
# For Local Development (direct):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docsupport
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/docsupport

# Task Queue & Cache (Redis 7 + Celery)
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For Local Development:
# REDIS_URL=redis://localhost:6379/0

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GUARD_MODEL=llama-3.1-8b-instant

# Embedding Model (BAAI/bge-base-en-v1.5, 768 dimensions)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
HUGGINGFACE_API_KEY=

# Clerk Authentication (JWT verification via JWKS)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Frontend Client (Port 5173)
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
